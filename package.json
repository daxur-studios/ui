{
  "name": "daxur-studios-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build ui",
    "build:ui": "ng build ui --configuration production",
    "pack:ui": "npm run build:ui && npm pack ./dist/ui --pack-destination ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.4",
    "@angular/compiler-cli": "^20.3.0",
    "ng-packagr": "^20.3.0",
    "prettier": "^3.5.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
